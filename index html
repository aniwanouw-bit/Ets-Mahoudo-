                    gallery.scrollIntoView({ behavior: 'smooth' });
                }, 200);
            }
        });

        // Fonction pour réinitialiser
        function resetAlbum() {
            gallery.style.display = 'none';
            isGalleryOpen = false;
            mainImage.style.borderColor = '#ffd700';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
